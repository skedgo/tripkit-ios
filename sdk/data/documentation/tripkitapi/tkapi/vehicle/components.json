{"sections":[],"abstract":[{"type":"text","text":"Components of this vehicle with additional information."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"components","kind":"identifier"},{"text":": [[","kind":"text"},{"text":"VehicleComponents","preciseIdentifier":"s:10TripKitAPI5TKAPIV17VehicleComponentsV","kind":"typeIdentifier","identifier":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI\/VehicleComponents"},{"text":"]]?","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"The top level array represents connected parts of the vehicle, which you can’t walk through","type":"text"},{"text":" ","type":"text"},{"text":"without leaving the vehicle (e.g., two trains connected together). The inner level array","type":"text"},{"text":" ","type":"text"},{"text":"represents then parts that can be walked through (e.g., the carriages of a train). A bus","type":"text"},{"text":" ","type":"text"},{"text":"would have a ","type":"text"},{"code":"[[component1]]","type":"codeVoice"},{"text":". A train could have ","type":"text"},{"code":"[[c1, c2, c3, c4], [c5, c6, c7, c8]]","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The arrays are ordered by direction of travel always being left-to-right,"},{"type":"text","text":" "},{"type":"text","text":"i.e., the front of the train is the very last element."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI\/Vehicle\/components","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TripKitAPI\/documentation\/TripKitAPI","doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI","doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI\/Vehicle"]]},"variants":[{"paths":["\/documentation\/tripkitap