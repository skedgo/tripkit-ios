{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/tripkitapi\/tkapi\/vehicle\/components"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"components"},{"kind":"text","text":": [["},{"kind":"typeIdentifier","identifier":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI\/VehicleComponents","text":"VehicleComponents","preciseIdentifier":"s:10TripKitAPI5TKAPIV17VehicleComponentsV"},{"kind":"text","text":"]]?"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The top level array represents connected parts of the vehicle, which you can’t walk through"},{"type":"text","text":" "},{"type":"text","text":"without leaving the vehicle (e.g., two trains connected together). The inner level array"},{"type":"text","text":" "},{"type":"text","text":"represents then parts that can be walked through (e.g., the carriages of a train). A bus"},{"type":"text","text":" "},{"type":"text","text":"would have a "},{"type":"codeVoice","code":"[[component1]]"},{"type":"text","text":". A train could have "},{"type":"codeVoice","code":"[[c1, c2, c3, c4], [c5, c6, c7, c8]]"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The arrays are ordered by direction of travel always being left-to-right,","type":"text"},{"text":" ","type":"text"},{"text":"i.e., the front of the train is the very last element.","type":"text"}]}],"kind":"content"}],"metadata":{"modules":[{"name":"TripKitAPI"}],"externalID":"s:10TripKitAPI5TKAPIV7VehicleV10componentsSaySayAC0E10ComponentsVGGSgvp","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"compo