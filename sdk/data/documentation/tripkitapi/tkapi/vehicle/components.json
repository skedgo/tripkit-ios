ype":"text","text":" "},{"type":"text","text":"represents then parts that can be walked through (e.g., the carriages of a train). A bus"},{"type":"text","text":" "},{"type":"text","text":"would have a "},{"type":"codeVoice","code":"[[component1]]"},{"type":"text","text":". A train could have "},{"type":"codeVoice","code":"[[c1, c2, c3, c4], [c5, c6, c7, c8]]"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The arrays are ordered by direction of travel always being left-to-right,"},{"type":"text","text":" "},{"type":"text","text":"i.e., the front of the train is the very last element."}],"type":"paragraph"}]}],"references":{"doc://TripKitAPI/documentation/TripKitAPI/TKAPI/Vehicle":{"role":"symbol","identifier":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI\/Vehicle","title":"TKAPI.Vehicle","kind":"symbol","abstract":[],"url":"\/documentation\/tripkitapi\/tkapi\/vehicle","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Vehicle"}],"navigatorTitle":[{"kind":"identifier","text":"Vehicle"}]},"doc://TripKitAPI/documentation/TripKitAPI/TKAPI":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TKAPI","kind":"identifier"}],"navigatorTitle":[{"text":"TKAPI","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/tripkitapi\/tkapi","title":"TKAPI","role":"symbol","abstract":[{"text":"Top-Level Namespace for model structs that","type":"text"},{"text":" ","type":"text"},{"text":"directly correspond to the TripGo API.","type":"text"}],"identifier":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI\/TKAPI","type":"topic"},"doc://TripKitAPI/documentation/TripKitAPI":{"kind":"symbol","role":"collection","type":"topic","title":"TripKitAPI","abstract":[{"type":"text","text":"Low-level API framework providing networking and data models for SkedGo’s transportation services."}],"identifier":"doc:\/\/TripKitAPI\/documentation\/TripKitAPI